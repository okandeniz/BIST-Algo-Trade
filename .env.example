# BIST100 Robot varsayılan ayarlarla .env olmadan da çalışır.
# Yalnızca aşağıdaki değerleri değiştirmek istiyorsanız bu dosyayı
# `.env` adıyla kopyalayın ve ilgili satırı yorumdan çıkarın.

SIGNAL_LOOKBACK_DAYS=900
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

