# ============================================================
# BIST-Algo-Trade — Public GitHub .gitignore
# ============================================================

# ------------------------------------------------------------
# Secrets, environment variables and credentials
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local

.streamlit/secrets.toml
secrets.toml
config.local.*
settings.local.*

credentials*.json
credential*.json
service_account*.json
client_secret*.json
token*.json

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# ------------------------------------------------------------
# Python virtual environments
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ------------------------------------------------------------
# Python cache, build and packaging
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# Tests, coverage and static analysis caches
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover

.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# ------------------------------------------------------------
# Jupyter
# Keep source notebooks, ignore checkpoints and exports
# ------------------------------------------------------------
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.nbconvert.ipynb

# ------------------------------------------------------------
# IDE and editor files
# ------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# Operating system files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------
# Logs, temporary files and caches
# ------------------------------------------------------------
logs/
*.log
*.log.*
tmp/
temp/
.cache/
cache/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------
# Local databases and user trading records
# Never publish portfolio, cash or transaction history
# ------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ------------------------------------------------------------
# Market data
# Raw, processed and live market files are reproducible,
# potentially large and may have redistribution restrictions.
# ------------------------------------------------------------
data/raw/**
data/processed/**
data/live/**

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/live/.gitkeep
!data/raw/bist100_sirketler.xlsx

!data/raw/README.md
!data/processed/README.md
!data/live/README.md

# Manual adjustment folder:
# keep documentation and the public ticker universe file only.
data/manual_adjustments/**
!data/manual_adjustments/.gitkeep
!data/manual_adjustments/README.md
!data/manual_adjustments/bist100_sirketler.xlsx

# Allow the ticker universe file if it is stored directly under data/
!data/bist100_sirketler.xlsx

# ------------------------------------------------------------
# Generated model artifacts
# Use Git LFS or GitHub Releases only when intentionally publishing.
# ------------------------------------------------------------
models/**
!models/.gitkeep
!models/README.md

*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.sav

# ------------------------------------------------------------
# Generated research and application outputs
# Includes backtests, paper-trading plans and SQLite state.
# ------------------------------------------------------------
results/**
!results/.gitkeep
!results/README.md

# ------------------------------------------------------------
# Data science binary/table exports outside managed folders
# Add a file explicitly with `git add -f` only after reviewing it.
# ------------------------------------------------------------
*.parquet
*.feather
*.arrow

# Do not globally ignore CSV/XLSX because the project may contain
# small public configuration files such as the BIST100 ticker list.
# Large exports should live under data/ or results/, which are ignored.

# ------------------------------------------------------------
# Frontend/runtime files
# ------------------------------------------------------------
.streamlit/cache/
.streamlit/static/generated/
frontend/.streamlit/cache/

# ------------------------------------------------------------
# FastAPI/Uvicorn runtime artifacts
# ------------------------------------------------------------
*.pid
uvicorn.pid

# ------------------------------------------------------------
# Local backups and archives
# ------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# ------------------------------------------------------------
# Optional local screenshots containing account or portfolio data
# Public, anonymized screenshots can be placed under docs/images/.
# ------------------------------------------------------------
screenshots/private/
private_screenshots/
